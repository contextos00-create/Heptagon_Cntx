# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CopilotKit BuiltInAgent also reads GOOGLE_API_KEY (aliased from GEMINI_API_KEY in server.ts).
# GOOGLE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Google OAuth for Drive / Docs live import.
# Keep notes: no public consumer API. Prefer Takeout OR unofficial gkeepapi bridge.
# Create Drive credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to ${APP_URL}/api/google/auth/callback
GOOGLE_REDIRECT_URI=""

# Unofficial Keep live sync (gkeepapi Python bridge: scripts/gkeep_bridge.py)
# Install: pip install -r requirements.txt
# Prefer master token auth (password login is deprecated / often blocked by Google).
GKEEP_EMAIL=""
GKEEP_MASTER_TOKEN=""
# GKEEP_PASSWORD=""   # discouraged
# GKEEP_PYTHON="python3"

# Durable LangGraph checkpoints: MemorySaver is used locally.
# For production, configure a Postgres/Redis checkpointer and set:
# LANGGRAPH_CHECKPOINT_BACKEND=memory
